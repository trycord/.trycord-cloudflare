{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trycord",
  "compatibility_date": "2026-09-27",
  "main": "cloudflare/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
